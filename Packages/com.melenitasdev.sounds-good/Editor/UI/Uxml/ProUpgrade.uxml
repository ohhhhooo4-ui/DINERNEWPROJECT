<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Packages/com.melenitasdev.sounds-good/Editor/UI/USS/MyStyles.uss?fileID=7433441132597879392&amp;guid=0ad9ef4d423fca64486bf660aba95f99&amp;type=3#MyStyles" />
    <ui:VisualElement name="Margins" style="flex-grow: 1; margin-top: 8px; margin-right: 10px; margin-bottom: 14px; margin-left: 10px;">

        <ui:VisualElement name="Header" style="flex-grow: 0; justify-content: center; min-height: 70px; border-left-color: rgb(255, 184, 119); border-right-color: rgb(255, 184, 119); border-top-color: rgb(255, 184, 119); border-bottom-color: rgb(255, 184, 119); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; background-color: rgba(135, 64, 0, 0.13); padding-left: 10px; padding-right: 10px;">
            <ui:Label tabindex="-1" text="AUDIO EFFECTS" focusable="false" name="FeatureTitle" class="title" style="font-size: 22px; -unity-text-align: middle-center;" />
            <ui:Label tabindex="-1" text="" focusable="false" name="FeatureDescription" style="color: rgb(255, 222, 179); -unity-text-align: middle-center; -unity-font-style: bold; font-size: 11px; white-space: normal; margin-top: 3px;" />
        </ui:VisualElement>

        <ui:VisualElement name="Unlocks" style="flex-grow: 0; flex-shrink: 0; margin-top: 6px; padding-top: 6px; padding-bottom: 6px; border-left-color: rgb(144, 102, 63); border-right-color: rgb(144, 102, 63); border-top-color: rgb(144, 102, 63); border-bottom-color: rgb(144, 102, 63); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; background-color: rgba(53, 53, 53, 0.47); justify-content: center;">

            <ui:Label tabindex="-1" text="YOU UNLOCK" focusable="false" name="UnlockHeading" style="color: rgb(255, 184, 119); -unity-text-align: middle-center; -unity-font-style: bold; font-size: 11px; letter-spacing: 2px; margin-bottom: 2px;" />
            <ui:VisualElement name="IconGrid" style="flex-grow: 0; flex-shrink: 0; flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: flex-start; align-content: flex-start;" />

            <ui:VisualElement name="MoreDivider" style="flex-shrink: 0; height: 1px; background-color: rgba(255, 184, 119, 0.25); margin-top: 10px; margin-bottom: 6px; margin-left: 24px; margin-right: 24px;" />
            <ui:Label tabindex="-1" text="AND MORE" focusable="false" name="MoreHeading" style="color: rgb(255, 184, 119); -unity-text-align: middle-center; -unity-font-style: bold; font-size: 10px; letter-spacing: 2px; margin-bottom: 3px;" />
            <ui:Label tabindex="-1" text="The Effect Creator and Occlusion Material Creator, effects on a whole channel or the entire game, a playable 3D demo scene, extra methods across the API…" focusable="false" name="MoreDetail" style="color: rgb(196, 160, 118); -unity-text-align: middle-center; font-size: 10px; white-space: normal; margin-left: 14px; margin-right: 14px;" />

        </ui:VisualElement>

        <ui:Button text="GET THE FULL VERSION" name="BuyButton" class="orange-button" style="flex-grow: 1; min-height: 44px; max-height: 54px; margin-top: 7px; font-size: 15px; -unity-font-style: bold; white-space: normal;" />

        <ui:VisualElement name="FooterRow" style="flex-direction: row; justify-content: space-between; align-items: center; margin-top: 7px;">
            <ui:Label tabindex="-1" text="One purchase, yours forever. Everything you set up carries over." focusable="false" style="color: rgb(170, 170, 170); font-size: 10px;" />
            <ui:Button text="What else does it do?" name="DocsButton" style="font-size: 10px; height: 18px; background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; color: rgb(255, 184, 119);" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
